# ============================================================
# ContractForge 环境变量模板
# 用法：cp .env.example .env，然后填入真实值
# ============================================================

# ---- LLM 远程 API（阿里云 DashScope，复用 agentforge 的 key）----
DASHSCOPE_API_KEY=

# ---- 数据库（PostgreSQL + pgvector）----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=contractforge
POSTGRES_PASSWORD=contractforge
POSTGRES_DB=contractforge

# ---- Redis（异步任务队列）----
REDIS_URL=redis://localhost:6379/0

# ---- JWT 认证 ----
JWT_SECRET_KEY=please-change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ---- 文件存储 ----
UPLOAD_DIR=./data/contracts

# ---- 日志 ----
LOG_LEVEL=INFO
